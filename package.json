{
    "name": "zustand-playground",
    "private": true,
    "type": "module",
    "scripts": {
        "vanilla": "bun vanilla/01-create-store.ts && bun vanilla/02-merge-replace.ts && bun vanilla/03-subscribe.ts && bun vanilla/04-actions.ts",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "check": "bun run fmt:check && bun run lint && bun run typecheck"
    },
    "dependencies": {
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "oxfmt": "0.71.0",
        "oxlint": "1.86.0",
        "typescript": "7.0.2",
        "vite": "8.3.1"
    },
    "engines": {
        "bun": ">=1.4.0"
    }
}
